#!/usr/bin/env bun
// Stop hook (and PreToolUse when TALK_NARRATE=on): speak the turn's prose that has not been
// spoken yet. Claude Code appends most in-turn prose to the transcript only at turn end, so
// timely mid-turn speech comes from the `speak` MCP tool instead; whatever that tool already
// said is skipped here. Blocks queue behind current speech; a new turn interrupts.
import { readFileSync, writeFileSync } from 'fs'
import { join } from 'path'
import { STATE_DIR, clearSpoken, enqueueSpeech, loadConfig, log, readSpoken, takeSpoken } from '../voice.ts'
import { sanitizeForSpeech, shouldSpeak, toolNarration, turnState } from '../talk.ts'

const PROGRESS = join(STATE_DIR, 'speak-progress')   // "<turnKey> <blocksSpoken> <speakThisTurn>"

let input: any = {}
try { input = JSON.parse(await new Response(Bun.stdin.stream()).text()) } catch {}
if (input.stop_hook_active) process.exit(0)
const event = String(input.hook_event_name ?? 'hook')

const cfg = loadConfig()
if (cfg.TALK_SPEAK === 'off') process.exit(0)
if (event === 'PreToolUse' && cfg.TALK_NARRATE !== 'on') process.exit(0)

let state = { key: -1, texts: [] as string[] }
try { state = turnState(readFileSync(String(input.transcript_path), 'utf8')) } catch {}
const last = typeof input.last_assistant_message === 'string' ? input.last_assistant_message.trim() : ''
if (last && !state.texts.some(t => t.trim() === last)) state.texts.push(last)

let [prevKey, prevCount, prevSpeak] = ['-1', '0', '']
try { [prevKey, prevCount, prevSpeak] = readFileSync(PROGRESS, 'utf8').trim().split(' ') } catch {}
const sameTurn = prevKey === String(state.key)

const speakThisTurn = sameTurn ? prevSpeak === '1' : shouldSpeak(cfg.TALK_SPEAK, takeSpoken())
const done = sameTurn ? Number(prevCount) || 0 : 0
writeFileSync(PROGRESS, `${state.key} ${state.texts.length} ${speakThisTurn ? 1 : 0}`)
if (!speakThisTurn) process.exit(0)

const spoken = readSpoken()
const max = Number(cfg.TALK_MAX_SPEAK_CHARS) || 1200
const parts = state.texts.slice(done).map(t => sanitizeForSpeech(t, max)).filter(t => t && !spoken.has(t))
if (event === 'PreToolUse') parts.push(sanitizeForSpeech(toolNarration(String(input.tool_name ?? ''), input.tool_input), max))
const text = parts.filter(Boolean).join(" ")
if (event === "Stop") clearSpoken()   // turn is over: forget what the speak tool said
if (!text) process.exit(0)

const pid = enqueueSpeech(text)   // always queue; pressing the talk key is what interrupts (hold.ts)
log(`${event}: turn ${state.key} blocks ${done}→${state.texts.length}, say ${pid}: "${text.slice(0, 50)}"`)
process.exit(0)
