#!/usr/bin/env python3
"""Wake-word detector: mic → openwakeword → one line per detection on stdout, "<model> <score>".

Several models run on the one mic stream; <model> is openwakeword's key (the .onnx basename).
Prints "ready" once the models are loaded. 2 s refractory per model so one utterance is one line.
Exits cleanly on SIGTERM. Run through bin/wake-detector (nix dev shell + venv python), see README.
  wake-listen --model hey_jarvis | /path/to/word.onnx [--threshold 0.5] [--model … [--threshold …]]
The i-th --threshold goes with the i-th --model; models without one use the first threshold.
"""
import argparse
import ctypes
import signal
import sys
import time

import sounddevice as sd
import openwakeword
from openwakeword.model import Model

RATE = 16000
CHUNK = 1280  # 80 ms, the frame size openwakeword expects
REFRACTORY_S = 2.0


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--model", action="append", help="prebuilt openwakeword name or path to an .onnx (repeatable)")
    ap.add_argument("--threshold", action="append", type=float)
    args = ap.parse_args()
    paths = args.model or ["hey_jarvis"]
    th = args.threshold or [0.5]
    th = th + [th[0]] * (len(paths) - len(th))
    prebuilt = [m for m in paths if not m.endswith(".onnx")]
    if prebuilt:
        openwakeword.utils.download_models(prebuilt)  # no-op once cached in the venv
    model = Model(wakeword_models=paths, inference_framework="onnx")
    # openwakeword's keys (basename of each model), in the order given; each with its threshold
    names = dict(zip(model.models, th))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    ctypes.CDLL(None).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG: no orphaned mic reader if the server dies
    print("ready", flush=True)
    last = dict.fromkeys(names, 0.0)
    with sd.InputStream(samplerate=RATE, channels=1, dtype="int16", blocksize=CHUNK) as mic:
        while True:
            frames, _ = mic.read(CHUNK)
            scores = model.predict(frames[:, 0])
            now = time.monotonic()
            for name, threshold in names.items():
                score = float(scores[name])
                if score >= threshold and now - last[name] >= REFRACTORY_S:
                    last[name] = now
                    print(f"{name} {score:.3f}", flush=True)


if __name__ == "__main__":
    main()
