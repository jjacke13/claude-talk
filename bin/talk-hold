#!/usr/bin/env bun
// talk-hold [--device /dev/input/eventN]   → global hold-to-talk daemon.
// Hold TALK_KEY (default Right Alt) from ANY window: key down → record, key up → whisper →
// inbox → session. Reads keyboards at the evdev level: your user must be in the `input` group.
import { createReadStream, readdirSync, readFileSync } from 'fs'
import { tmpdir } from 'os'
import { join } from 'path'
import { unlinkSync } from 'fs'
import { drop, loadConfig, log, markSpoken, startRecording, transcribe } from '../voice.ts'

const KEYS: Record<string, number> = {
  KEY_RIGHTALT: 100, KEY_LEFTALT: 56, KEY_RIGHTCTRL: 97, KEY_LEFTCTRL: 29, KEY_RIGHTMETA: 126,
  KEY_LEFTMETA: 125, KEY_CAPSLOCK: 58, KEY_SCROLLLOCK: 70, KEY_PAUSE: 119, KEY_MENU: 139,
  KEY_F9: 67, KEY_F10: 68, KEY_F11: 87, KEY_F12: 88,
}
const EV_KEY = 1, PRESS = 1, RELEASE = 0, MIN_HOLD_MS = 300
const cfg = loadConfig()
const keyName = cfg.TALK_KEY
const keyCode = KEYS[keyName] ?? Number(keyName)
if (!Number.isInteger(keyCode)) { log(`TALK_KEY "${keyName}" unknown — use one of ${Object.keys(KEYS).join(' ')} or a numeric evdev code`); process.exit(1) }

// Which devices: --device X, else every /dev/input/event* whose name looks like a keyboard.
const argDev = process.argv.indexOf('--device')
const devices = argDev >= 0 ? [process.argv[argDev + 1]!] : readdirSync('/dev/input')
  .filter(n => n.startsWith('event'))
  .filter(n => { try { return /keyboard|kbd/i.test(readFileSync(`/sys/class/input/${n}/device/name`, 'utf8')) } catch { return false } })
  .map(n => `/dev/input/${n}`)
if (!devices.length) { log('no keyboard device found under /dev/input (or not readable — add your user to the `input` group)'); process.exit(1) }

let rec: ReturnType<typeof startRecording> | undefined
let wav = ''
let t0 = 0
let busy = false

async function onKey(value: number): Promise<void> {
  if (value === PRESS && !rec && !busy) {
    wav = join(tmpdir(), `talk-hold-${process.pid}.wav`)
    rec = startRecording(wav)
    t0 = Date.now()
    log('recording… (release to send)')
    return
  }
  if (value === RELEASE && rec) {
    const r = rec; rec = undefined; busy = true
    r.kill('SIGINT'); await r.exited
    try {
      if (Date.now() - t0 < MIN_HOLD_MS) { log('tap ignored (hold the key while speaking)'); return }
      const text = await transcribe(cfg, wav)
      if (!text || /^\[.*\]$/.test(text)) { log('(nothing heard)'); return }
      log(`heard: ${text}`)
      markSpoken()
      drop(text)
    } finally { try { unlinkSync(wav) } catch {}; busy = false }
  }
}

// struct input_event on 64-bit: u64 sec, u64 usec, u16 type, u16 code, s32 value = 24 bytes.
function listen(path: string): void {
  let rest = Buffer.alloc(0)
  const s = createReadStream(path)
  s.on('data', (chunk: Buffer) => {
    let buf = rest.length ? Buffer.concat([rest, chunk]) : chunk
    let off = 0
    for (; off + 24 <= buf.length; off += 24) {
      if (buf.readUInt16LE(off + 16) === EV_KEY && buf.readUInt16LE(off + 18) === keyCode) void onKey(buf.readInt32LE(off + 20))
    }
    rest = buf.subarray(off)
  })
  s.on('error', e => log(`${path}: ${(e as Error).message} — not readable? add your user to the input group`))
  s.on('end', () => log(`${path}: closed`))
}
for (const d of devices) listen(d)
log(`hold ${keyName} to talk — listening on ${devices.join(', ')}`)
